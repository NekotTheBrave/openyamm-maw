; OpenYAMM settings: only the values you changed. Everything else follows the game's defaults.
; Volumes use the original-style 0..9 scale.

[profile]
name=desktop
version=5

[audio]
music_volume=4
voice_volume=4

[gameplay]
quest_markers=true
context_action_popup=false

[logging]
fps_trace=true

[video]
warm_torch_light=true
shadows=false
model_shadow_quality=0
ambient_occlusion=false
ambient_occlusion_strength=100
bloom=true
antialiasing=off
water_sprite_reflections=false
terrain_anisotropy=4x
skip_event_cutscenes=true
window_mode=windowed
resolution=1600x900
vsync=false

[debug]
start_world=mm7
start_map_file=oute3.odm
turbo_movement=true
new_game_god_lich=true
console=true
